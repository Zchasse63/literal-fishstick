flowchart TD
    subgraph CLIENT["Client (Browser)"]
        UI["Admin UI / Hooks\n(AbortController, polling)"]
    end

    subgraph API["API Layer (Next.js Routes)"]
        RL["Rate Limiter\n(in-memory, 20 req/min)"]
        AUTH["requireRole()\nAuth Guard"]
        CACHE["ai_cache / ai_briefings\n(Supabase — 24h TTL)"]
        ROUTES["13 AI Route Handlers\n/api/ai/*"]
    end

    subgraph LIBAI["lib/ai/ + lib/anthropic.ts"]
        CLIENT_MOD["client.ts\nSingleton Anthropic\nAI_MODEL constant"]
        BRIEFING["anthropic.ts\nbriefing, recommendations\ncampaign-copy, health-score\nnl-search, lead-score\nsubject-lines, send-time\ncampaign-summary, automation-recs"]
        AIMOD["lib/ai/ modules\nchurn-prediction\nbooking-patterns\nrevenue-anomaly\ninsights-generator\ntrainer-summary\nwaitlist-messaging\nauto-reply\nintake-enrichment"]
        DEADMOD["lib/ai/ — NO API ROUTE\ncross-sell\npricing-analyzer\nseasonal-predictor\nreport-narrative\ntrainer-comparison"]
    end

    subgraph ANTHROPIC["Anthropic API"]
        MODEL_MAIN["claude-sonnet-4-6\n(9 modules)"]
        MODEL_OLD["claude-sonnet-4-20250514\n(6 modules — stale ID)"]
    end

    subgraph FALLBACK["Rules-Based Fallbacks"]
        RB["Every module has\nfull rules-based fallback\nif API unavailable"]
    end

    subgraph DB["Supabase Database"]
        TABLES["members, bookings\ntransactions, classes\nprofiles, credit_packs\nemail_send_log"]
        CACHE_TABLE["ai_cache\nai_briefings\nai_insights"]
    end

    UI -->|"fetch + AbortController"| ROUTES
    ROUTES --> AUTH
    AUTH --> RL
    RL -->|"check cache"| CACHE
    CACHE -->|"cache miss"| AIMOD
    CACHE -->|"cache miss"| BRIEFING
    AIMOD --> CLIENT_MOD
    BRIEFING --> CLIENT_MOD
    CLIENT_MOD -->|"primary"| MODEL_MAIN
    CLIENT_MOD -->|"stale model ID\nin 6 modules"| MODEL_OLD
    MODEL_MAIN -->|"JSON output\nvalidated"| AIMOD
    MODEL_OLD -->|"JSON output\nvalidated"| AIMOD
    MODEL_MAIN -->|"error / key missing"| RB
    MODEL_OLD -->|"error / key missing"| RB
    ROUTES -->|"parallel queries"| TABLES
    AIMOD -->|"persist results"| CACHE_TABLE
    DEADMOD -.->|"implemented but\nnot routed"| CLIENT_MOD

