erDiagram
    %% ─── Core Identity ───────────────────────────────────────────
    studios {
        uuid id PK
        text name
        timestamptz created_at
    }

    profiles {
        uuid id PK
        uuid studio_id FK
        text email
        text full_name
        text phone
        text[] roles
        boolean is_active
        boolean exclude_from_analytics
        int health_score
        text health_risk_level
        date date_of_birth
        text glofox_id
        text timezone
        text acquisition_source
        timestamptz created_at
    }

    %% ─── Membership ──────────────────────────────────────────────
    members {
        uuid id PK
        uuid studio_id FK
        uuid profile_id FK
        uuid membership_plan_id FK
        text membership_tier
        text membership_status
        text stripe_customer_id
        text stripe_subscription_id
        int credits_remaining
        int wallet_balance
        int total_visits
        date join_date
        timestamptz last_visit
        int lifetime_value
        text glofox_id
        timestamptz created_at
    }

    membership_plans {
        uuid id PK
        uuid studio_id FK
        text name
        text tier
        int price
        int credits_per_cycle
        int guest_passes_per_cycle
        text stripe_price_id
        boolean is_active
        int sort_order
        text glofox_id
    }

    credit_packs {
        uuid id PK
        uuid studio_id FK
        uuid member_id FK
        text pack_type
        int credits_total
        int credits_remaining
        timestamptz expires_at
        timestamptz grace_period_ends_at
        text glofox_id
    }

    %% ─── Classes & Bookings ──────────────────────────────────────
    classes {
        uuid id PK
        uuid studio_id FK
        uuid location_id FK
        uuid class_type_id FK
        uuid trainer_id FK
        text title
        timestamptz starts_at
        timestamptz ends_at
        int capacity
        int booked_count
        int checked_in_count
        text status
        boolean is_recurring
        text glofox_id
    }

    class_types {
        uuid id PK
        uuid studio_id FK
        text name
        text description
        text color
    }

    bookings {
        uuid id PK
        uuid studio_id FK
        uuid class_id FK
        uuid member_id FK
        uuid credit_pack_id FK
        text status
        int credits_deducted
        timestamptz checked_in_at
        boolean is_late_cancellation
        boolean is_walk_in
        boolean is_guest
        text glofox_id
        text glofox_write_status
        timestamptz created_at
    }

    waitlist_entries {
        uuid id PK
        uuid studio_id FK
        uuid class_id FK
        uuid member_id FK
        uuid booking_id FK
        text status
        int position
        timestamptz offered_at
        timestamptz claim_deadline
    }

    %% ─── Revenue ─────────────────────────────────────────────────
    transactions {
        uuid id PK
        uuid studio_id FK
        uuid member_id FK
        int amount
        text type
        text status
        text currency
        int tax_amount
        text glofox_id
        timestamptz created_at
    }

    gift_cards {
        uuid id PK
        uuid studio_id FK
        text code
        int amount
        uuid redeemed_by_member_id FK
        boolean is_redeemed
        text stripe_payment_intent_id
    }

    %% ─── Merchandise ─────────────────────────────────────────────
    products {
        uuid id PK
        uuid studio_id FK
        text name
        int price
        text sku
        int inventory_count
        boolean is_active
        boolean requires_shipping
    }

    orders {
        uuid id PK
        uuid studio_id FK
        uuid member_id FK
        text status
        text fulfillment_type
        int subtotal
        int total
    }

    order_items {
        uuid id PK
        uuid order_id FK
        uuid product_id FK
        text product_name
        int quantity
        int unit_price
        int total
    }

    %% ─── Staff & Operations ──────────────────────────────────────
    trainers {
        uuid id PK
        uuid studio_id FK
        uuid profile_id FK
        text promo_code
        int bonus_threshold
        text glofox_id
    }

    trainer_bonuses {
        uuid id PK
        uuid studio_id FK
        uuid trainer_id FK
        uuid class_id FK
        int check_in_count
        int threshold
        text status
    }

    employees {
        uuid id PK
        uuid studio_id FK
        uuid user_id FK
        text employment_type
        text status
        date hire_date
        int hourly_rate
    }

    clock_entries {
        uuid id PK
        uuid studio_id FK
        uuid employee_id FK
        timestamptz clock_in
        timestamptz clock_out
        number total_hours
        boolean geofence_verified_in
        text status
    }

    %% ─── Corporate & Events ──────────────────────────────────────
    company_accounts {
        uuid id PK
        uuid studio_id FK
        text name
        text contact_email
        text stripe_customer_id
        int monthly_credit_allocation
        int credits_remaining
        text status
    }

    company_members {
        uuid id PK
        uuid studio_id FK
        uuid company_id FK
        uuid member_id FK
        text role
        boolean is_active
    }

    events {
        uuid id PK
        uuid studio_id FK
        uuid company_id FK
        text name
        text event_type
        timestamptz start_time
        timestamptz end_time
        int max_guests
        text status
    }

    event_guests {
        uuid id PK
        uuid studio_id FK
        uuid event_id FK
        uuid member_id FK
        text guest_name
        text guest_email
        text rsvp_status
    }

    %% ─── Phase 2 Marketing ───────────────────────────────────────
    campaigns {
        uuid id PK
        uuid studio_id FK
        uuid segment_id FK
        text name
        text status
        text[] channels
        text subject
        int open_count
        int click_count
        int recipient_count
        boolean ab_test_enabled
    }

    campaign_recipients {
        uuid id PK
        uuid studio_id FK
        uuid campaign_id FK
        uuid member_id FK
        text status
        text channel
        timestamptz opened_at
        timestamptz clicked_at
    }

    automation_flows {
        uuid id PK
        uuid studio_id FK
        text name
        text trigger_type
        jsonb steps
        boolean is_active
        int version
        boolean allow_reenrollment
    }

    automation_enrollments {
        uuid id PK
        uuid studio_id FK
        uuid automation_id FK
        uuid member_id FK
        int current_step
        text status
        int flow_version
        jsonb step_history
    }

    leads {
        uuid id PK
        uuid studio_id FK
        uuid converted_member_id FK
        text email
        text first_name
        text status
        text source
        int score
        text email_hash
    }

    lead_activities {
        uuid id PK
        uuid studio_id FK
        uuid lead_id FK
        text activity_type
        text description
    }

    email_preferences {
        uuid id PK
        uuid studio_id FK
        uuid member_id FK
        boolean marketing_email
        boolean transactional_email
        boolean hard_bounced
    }

    %% ─── Glofox Sync ─────────────────────────────────────────────
    glofox_sync_state {
        uuid id PK
        uuid studio_id FK
        text entity_type
        timestamptz last_synced_at
        text status
    }

    glofox_sync_conflicts {
        uuid id PK
        uuid studio_id FK
        text entity_type
        text entity_id
        text conflict_type
        jsonb glofox_data
        jsonb meridian_data
    }

    %% ─── Analytics & Support ────────────────────────────────────
    activity_log {
        uuid id PK
        uuid studio_id FK
        uuid actor_id FK
        text type
        text subject_type
        uuid subject_id
        jsonb metadata
        timestamptz created_at
    }

    daily_metrics {
        uuid id PK
        uuid studio_id FK
        date metric_date
        int revenue_total
        int total_bookings
        int total_checkins
        int classes_held
        number avg_attendance
    }

    smart_segments {
        uuid id PK
        uuid studio_id FK
        text name
        text type
        jsonb rules
        int member_count
    }

    %% ─── Relationships ───────────────────────────────────────────

    studios ||--o{ profiles : "has many"
    studios ||--o{ members : "has many"
    studios ||--o{ classes : "has many"
    studios ||--o{ membership_plans : "has many"
    studios ||--o{ company_accounts : "has many"
    studios ||--o{ events : "has many"
    studios ||--o{ campaigns : "has many"
    studios ||--o{ automation_flows : "has many"
    studios ||--o{ leads : "has many"
    studios ||--o{ glofox_sync_state : "has sync state"

    profiles ||--o| members : "has member record"
    profiles ||--o| trainers : "may be trainer"
    profiles ||--o| employees : "may be employee"

    members ||--o{ bookings : "books"
    members ||--o{ credit_packs : "owns"
    members ||--o{ transactions : "pays"
    members ||--o{ orders : "orders"
    members ||--o| email_preferences : "has prefs"
    members }o--o{ company_accounts : "company_members"

    membership_plans ||--o{ members : "plan for"

    classes ||--o{ bookings : "has bookings"
    classes ||--o{ waitlist_entries : "has waitlist"
    class_types ||--o{ classes : "classifies"

    bookings ||--o| credit_packs : "deducted from"
    bookings ||--o| waitlist_entries : "promoted from"

    trainers ||--o{ trainer_bonuses : "earns"
    classes ||--o{ trainer_bonuses : "triggers"

    employees ||--o{ clock_entries : "clocks"

    company_accounts ||--o{ events : "hosts"
    events ||--o{ event_guests : "has guests"

    orders ||--o{ order_items : "contains"
    products ||--o{ order_items : "in orders"

    campaigns ||--o{ campaign_recipients : "sends to"
    automation_flows ||--o{ automation_enrollments : "enrolls"
    profiles ||--o{ automation_enrollments : "enrolled in"
    leads ||--o{ lead_activities : "has timeline"
    leads }o--o| profiles : "converts to"
