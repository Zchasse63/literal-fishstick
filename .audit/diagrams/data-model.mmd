    bookings {
        uuid id PK
        uuid studio_id FK
        uuid class_id FK
        uuid member_id FK
        text status
        timestamptz booked_at
        timestamptz checked_in_at
    }

    profiles {
        uuid id PK
        uuid studio_id FK
        text roles
        text membership_type
        text membership_status
        boolean exclude_from_analytics
        text acquisition_source
        text timezone
    }

    campaigns {
        uuid id PK
        uuid studio_id FK
        text status
        text[] channels
        boolean ab_test_enabled
        jsonb ab_variants
        int recipient_count
        int open_count
        int click_count
    }

    automation_flows {
        uuid id PK
        uuid studio_id FK
        text trigger_type
        jsonb trigger_config
        jsonb steps
        boolean is_active
        int version
        bool allow_reenrollment
    }
