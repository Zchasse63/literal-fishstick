        WH["Webhook Handlers\nStripe: HMAC verified\nResend: Svix verified\nTwilio: UNKNOWN\nEasyPost: UNKNOWN"]
    end

    subgraph DB["Database Layer"]
        SUPA_AUTH[Supabase Auth\nJWT validation]
        RLS["RLS Policies\nCRITICAL: app.studio_id\nsession var may not be set"]
        POSTGRES[(PostgreSQL)]
    end

    LEGIT --> AUTHED
    ANON --> UNPROTECTED
    WEBHOOKS --> WH

    AUTHED --> SUPA_AUTH
    SUPA_AUTH --> RLS
    RLS --> POSTGRES

    WH --> POSTGRES
    UNPROTECTED --> POSTGRES

