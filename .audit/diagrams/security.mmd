graph TD
    subgraph Internet["Public Internet"]
        LEGIT[Authenticated Admin/Employee\nSupabase JWT session]
        ANON[Unauthenticated Requests]
        WEBHOOKS[External Webhooks\nStripe · Resend · Twilio · EasyPost]
    end

    subgraph NextJS["Next.js Server (no middleware.ts)"]
        UNPROTECTED["Public Endpoints\n/api/leads/capture — no rate limit\n/api/openapi — schema exposed\n/api/unsubscribe/token"]
