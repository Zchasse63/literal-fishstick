graph TD
    APP["Meridian\n(Next.js 16 / Netlify)"]

    %% Databases & Auth
    SUPA["Supabase\n(PostgreSQL + Auth + RLS)"]
    SUPAB["Supabase\n(Service Role / Inngest)"]

    %% Payments
    STRIPE["Stripe\n(subscriptions, checkout,\nwebhooks)"]

    %% AI
    ANTHROPIC["Anthropic\n(Claude Sonnet 4.6\n13 AI endpoints)"]

    %% Email
    RESEND["Resend\n(transactional + campaigns\n+ tracking webhooks via Svix)"]
    SVIX["Svix\n(webhook verification\nfor Resend)"]

    %% SMS
    TWILIO["Twilio\n(SMS — stubbed,\nTwilioProvider ready)"]

    %% Background Jobs
    INNGEST["Inngest\n(19 functions:\ncrons + automation\n+ Glofox write-back)"]

    %% Glofox
    GLOFOX["Glofox API\n(read + write-back\nGlofox REST v2.x)"]

    %% Shipping
    EASYPOST["EasyPost\n(shipping rates + labels\ntracking webhooks)"]

    %% Social embed
    SNAPWIDGET["SnapWidget\n(Instagram embed\nno API key)"]

    %% Data flow — primary
    APP -->|"cookie-auth RLS queries"| SUPA
    INNGEST -->|"service-role queries\n(bypass RLS)"| SUPAB
    APP -->|"Stripe SDK\ncheckout, subscriptions,\nproration"| STRIPE
    STRIPE -->|"webhook POST\nsignature verified"| APP
    APP -->|"Anthropic SDK\nmessages.create\nno timeout set"| ANTHROPIC
    APP -->|"Resend SDK\ntransactional + batch"| RESEND
    RESEND -->|"Svix-signed\nwebhook POST\ndelivered/opened/\nbounced/clicked"| APP
    SVIX -.->|"signs Resend webhooks"| RESEND
    APP -->|"SMSProvider factory\n(stub default)"| TWILIO
    TWILIO -->|"POST webhook\nauth conditional\non env var"| APP
    APP -->|"inngest.send()\nevents"| INNGEST
    INNGEST -->|"crons + async\nflow execution"| INNGEST
    INNGEST -->|"GlofoxClient\nhourly sync +\nwrite-back"| GLOFOX
    GLOFOX -->|"incremental sync\nread-only + write-back\n(attendance, booking)"| INNGEST
    APP -->|"EasyPost API\nshipping rates\n(if EASYPOST_API_KEY set)"| EASYPOST
    EASYPOST -->|"tracker.updated webhook\nHMAC conditional\non env var"| APP
    APP -.->|"iframe embed\nno backend touch"| SNAPWIDGET

    %% Color coding
    classDef green fill:#10B981,stroke:#065F46,color:#fff
    classDef yellow fill:#F59E0B,stroke:#92400E,color:#fff
    classDef red fill:#EF4444,stroke:#991B1B,color:#fff
    classDef purple fill:#7C3AED,stroke:#4C1D95,color:#fff
    classDef gray fill:#9CA3AF,stroke:#4B5563,color:#fff

    class APP green
    class SUPA,SUPAB green
    class STRIPE green
    class RESEND,SVIX green
    class ANTHROPIC yellow
    class INNGEST green
    class GLOFOX yellow
    class TWILIO yellow
    class EASYPOST red
    class SNAPWIDGET gray
