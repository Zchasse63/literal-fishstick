# Meridian — Environment Variables
# Copy this file to .env.local and fill in your values
# All variables are REQUIRED unless marked (optional)

# ═══════════════════════════════════════════════════
# Supabase
# ═══════════════════════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_your-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ═══════════════════════════════════════════════════
# Anthropic AI (Claude)
# ═══════════════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-api03-your-key

# ═══════════════════════════════════════════════════
# Stripe (Payments)
# ═══════════════════════════════════════════════════
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key

# ═══════════════════════════════════════════════════
# Resend (Email)
# ═══════════════════════════════════════════════════
RESEND_API_KEY=re_your-key
RESEND_WEBHOOK_SECRET=whsec_your-secret

# ═══════════════════════════════════════════════════
# Twilio (SMS) — optional, stubbed for Phase 1
# ═══════════════════════════════════════════════════
# TWILIO_ACCOUNT_SID=your-sid
# TWILIO_AUTH_TOKEN=your-token
# TWILIO_PHONE_NUMBER=+1234567890

# ═══════════════════════════════════════════════════
# EasyPost (Shipping) — optional, future feature
# ═══════════════════════════════════════════════════
# EASYPOST_API_KEY=your-key
# EASYPOST_WEBHOOK_SECRET=your-secret

# ═══════════════════════════════════════════════════
# Inngest (Background Jobs)
# ═══════════════════════════════════════════════════
INNGEST_SIGNING_KEY=signkey-your-key
INNGEST_EVENT_KEY=your-event-key

# ═══════════════════════════════════════════════════
# Glofox (Data Sync — read-only)
# ═══════════════════════════════════════════════════
GLOFOX_API_KEY=your-key
GLOFOX_API_TOKEN=your-token
GLOFOX_BRANCH_ID=your-branch-id
GLOFOX_STUDIO_ID=your-studio-uuid

# ═══════════════════════════════════════════════════
# Multi-Tenancy
# ═══════════════════════════════════════════════════
DEFAULT_STUDIO_ID=your-studio-uuid

# ═══════════════════════════════════════════════════
# Cron Job Security
# ═══════════════════════════════════════════════════
CRON_SECRET=your-cron-secret

# ═══════════════════════════════════════════════════
# Email Configuration
# ═══════════════════════════════════════════════════
EMAIL_UNSUBSCRIBE_SECRET=your-hmac-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000
